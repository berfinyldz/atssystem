<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Kontrol Paneli</title>
    <link href="~/css/ikmain.css" rel="stylesheet" />
</head>
<body>

    <input type="checkbox" id="menu-toggle">

    <div class="navbar">
        <label for="menu-toggle" class="menu-button">&#9776;</label>
        <div class="navbar-brand">IK <span>/ Kontrol Paneli</span></div>
        <input type="text" class="navbar-search" placeholder="Ara...">
        <div class="navbar-right">
            <div class="icon-button">&#128276;</div>
            <div class="user-info">
                ---
                <small>İk Departmanı</small>
            </div>
        </div>
    </div>

    <label for="menu-toggle" class="overlay"></label>

    <div class="sidebar">
        <div class="sidebar-title">BAŞVURULAR</div>
        <a class="active" href="#">Panel</a>
        <a href="#">İş İlanları</a>
        <a href="#">Başvurular</a>
        <a href="#">Adaylar</a>

        <div class="sidebar-title">İŞE ALIM</div>
        <a href="#">Mülakatlar</a>
        <a href="#">Değerlendirmeler</a>
        <a href="#">İşe Alım Süreci</a>

        <div class="sidebar-title">RAPORMALAR</div>
        <a href="#">Analitik</a>
        <a href="#">Raporlar</a>
        <a asp-controller="Home" asp-action="Index">Çıkış</a>
    </div>
    <div class="sidebar-title">YÖNETİM</div>
    <a asp-controller="Home" asp-action="Index">İk Kullanıcıları</a>
    <a asp-controller="Home" asp-action="Index">ÇIKIŞ</a>
    

    <div class="main">
        <div class="content">
            @RenderBody()
        </div>
    </div>

</body>
</html>

